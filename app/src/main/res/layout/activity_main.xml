<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Burst Rhythm Testbed"
        android:textColor="#E0E0E0"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Status: IDLE"
        android:textColor="#9E9E9E"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/rgMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#1E1E1E"
        android:padding="12dp">

        <RadioButton
            android:id="@+id/rbPassthrough"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Baseline (Mengalir Normal)"
            android:textColor="#E0E0E0" />

        <RadioButton
            android:id="@+id/rbAdaptiveRhythm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Adaptive Rhythm (Jeda &amp; Prioritas)"
            android:textColor="#E0E0E0" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Rate: 0.0 KB/s\nStall Count: 0\nState: PASS_OPEN"
            android:textColor="#80CBC4"
            android:textSize="14sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etTargetPackage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E1E1E"
        android:hint="Package target (kosong = semua app, misal: com.android.chrome)"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#757575"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnToggleVpn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#2E7D32"
        android:text="START EXPERIMENT"
        android:textColor="#FFFFFF" />

</LinearLayout>
